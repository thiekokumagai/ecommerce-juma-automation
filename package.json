{
  "name": "juma-automation",
  "version": "1.0.0",
  "description": "Serviço de automação de entregas Juma para Pod & Mais",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:cli": "node index.js",
    "build": "electron-builder --win",
    "start:silent": "wscript iniciar_silencioso.vbs",
    "startup:install": "instalar_inicializacao_windows.bat",
    "startup:remove": "remover_inicializacao_windows.bat",
    "queue:reset": "node scripts/reset-order.js",
    "queue:list": "node scripts/list-queue.js",
    "queue:clear": "node scripts/clear-queue.js",
    "test": "jest --runInBand",
    "juma:inspect": "node scripts/inspect-juma.js",
    "juma:gestao": "node scripts/inspect-gestao.js"
  },
  "build": {
    "appId": "com.podemais.jumaautomation",
    "productName": "Juma Automação",
    "artifactName": "juma-automation-setup.exe",
    "files": [
      "**/*",
      ".env",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Juma Automação"
    }
  },
  "keywords": [],
  "author": "Pod & Mais",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.2"
  }
}
